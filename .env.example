# Copy to .env and edit. Never commit .env.
ENVIRONMENT=local                  # "production" disables demo users and rejects the default or a <32-byte JWT secret
JWT_SECRET=generate-a-long-random-string   # python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./documind.db       # compose/k8s use postgresql+psycopg://user:pass@host:5432/db
REDIS_URL=                                   # e.g. redis://localhost:6379/0 (required for multi-replica)
VECTOR_BACKEND=memory                        # memory | qdrant
QDRANT_URL=                                  # empty with VECTOR_BACKEND=qdrant => embedded single-process Qdrant
LLM_PROVIDER=mock                            # mock | anthropic (needs ANTHROPIC_API_KEY + requirements-llm.txt)
ANTHROPIC_API_KEY=
REVIEW_CONFIDENCE_THRESHOLD=0.85
OTLP_ENDPOINT=                               # e.g. http://localhost:4318/v1/traces
